# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Never commit it, never paste it into chat,
# and never put NEXT_PUBLIC_ in front of these names (that would expose them
# to the browser).

# Create a key at https://aistudio.google.com/ ("Get API key").
GEMINI_API_KEY=

# Model used for drafting. Change it here if Google renames or retires it.
GEMINI_MODEL=gemini-2.5-flash
